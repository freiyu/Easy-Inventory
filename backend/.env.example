# Development only (PRD 13.2). Copy to backend/.env and fill in. Placeholders only: never commit real values.
# In production the installer generates these on the host (PRD 6.7).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/ezi_dev
# Only for `prisma migrate dev` (needs its own empty database).
SHADOW_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/ezi_dev_shadow
SESSION_SECRET=CHANGE_ME
PORT=4000
HOST=127.0.0.1
TZ=Asia/Jakarta
# Backups and the error log. Optional: MYSQLDUMP_PATH (default: mysqldump on PATH), STATIC_DIR (default: ../frontend/out).
DATA_DIR=./data
